server:
  http_listen_port: 9080
  grpc_listen_port: 0
  log_level: info

positions:
  filename: /positions/positions.yaml

clients:
  - url: {{ promtail_loki_url }}
    backoff_config:
      min_period: 500ms
      max_period: 5m
      max_retries: 10
    batchwait: 1s
    batchsize: 1048576
    external_labels:
      env: {{ promtail_env }}
      app: {{ promtail_app }}
      host: {{ promtail_host }}

scrape_configs:
  # === Docker container logs (auto-discovery) ===
  - job_name: docker
    docker_sd_configs:
      - host: unix:///var/run/docker.sock
        refresh_interval: 5s
    relabel_configs:
      - source_labels: ['__meta_docker_container_name']
        regex: '/?(.*)'
        target_label: 'container'
      - source_labels: ['__meta_docker_container_log_stream']
        target_label: 'stream'
      - target_label: 'job'
        replacement: 'docker'
    pipeline_stages:
      - docker: {}
      - json:
          expressions:
            level: level
            logger: logger_name
            message: message

  # === Nginx access logs (JSON) ===
  - job_name: nginx-access
    static_configs:
      - targets:
          - localhost
        labels:
          job: nginx-access
          __path__: {{ promtail_nginx_logs_path }}/access.log
    pipeline_stages:
      - json:
          expressions:
            remote_addr: remote_addr
            method: request_method
            uri: request_uri
            status: status
            request_time: request_time
            upstream_time: upstream_response_time
      - labels:
          method:
          status:

  # === Nginx error logs ===
  - job_name: nginx-error
    static_configs:
      - targets:
          - localhost
        labels:
          job: nginx-error
          __path__: {{ promtail_nginx_logs_path }}/error.log