apiVersion: 1

groups:
  - orgId: 1
    name: bulletins-alerts
    folder: Bulletins
    interval: 1m
    rules:

      - uid: alert-instance-down
        title: "InstanceDown — target unreachable"
        condition: C
        for: {{ alert_instancedown_for }}
        noDataState: Alerting
        execErrState: Error
        notification_settings:
          receiver: email-admin
        labels:
          severity: critical
          service: infrastructure
        annotations:
          summary: "One or more Prometheus targets are down"
          description: "At least one Prometheus target has been unreachable for more than {{ alert_instancedown_for }}. Check Prometheus targets page."
        data:
          - refId: A
            relativeTimeRange: { from: 300, to: 0 }
            datasourceUid: prometheus
            model:
              editorMode: code
              expr: min(up)
              instant: true
              intervalMs: 1000
              maxDataPoints: 43200
              range: false
              refId: A
          - refId: C
            datasourceUid: __expr__
            model:
              conditions:
                - evaluator: { params: [1], type: lt }
                  operator: { type: and }
                  query: { params: [A] }
                  reducer: { type: last }
                  type: query
              datasource: { type: __expr__, uid: __expr__ }
              expression: A
              refId: C
              type: threshold

      - uid: alert-app-down
        title: "AppDown — Spring Boot unreachable"
        condition: C
        for: {{ alert_appdown_for }}
        noDataState: Alerting
        execErrState: Error
        notification_settings:
          receiver: email-admin
        labels:
          severity: critical
          service: bulletins-app
        annotations:
          summary: "Bulletins app is DOWN"
          description: "Spring Boot Actuator target is unreachable for more than {{ alert_appdown_for }}."
        data:
          - refId: A
            relativeTimeRange: { from: 300, to: 0 }
            datasourceUid: prometheus
            model:
              editorMode: code
              expr: up{job="spring-actuator"}
              instant: true
              range: false
              refId: A
          - refId: C
            datasourceUid: __expr__
            model:
              conditions:
                - evaluator: { params: [1], type: lt }
                  operator: { type: and }
                  query: { params: [A] }
                  reducer: { type: last }
                  type: query
              datasource: { type: __expr__, uid: __expr__ }
              expression: A
              refId: C
              type: threshold

      - uid: alert-high-5xx
        title: "High5xxRate — application errors"
        condition: C
        for: {{ alert_5xx_for }}
        noDataState: OK
        execErrState: Error
        notification_settings:
          receiver: email-admin
        labels:
          severity: warning
          service: bulletins-app
        annotations:
          summary: "High 5xx error rate (> {{ alert_5xx_rate_threshold }} req/s for {{ alert_5xx_for }})"
          description: "More than {{ alert_5xx_rate_threshold }} 5xx responses per second in the last {{ alert_5xx_for }}."
        data:
          - refId: A
            relativeTimeRange: { from: 600, to: 0 }
            datasourceUid: prometheus
            model:
              editorMode: code
              expr: sum(rate(http_server_requests_seconds_count{status=~"5.."}[5m]))
              instant: true
              range: false
              refId: A
          - refId: C
            datasourceUid: __expr__
            model:
              conditions:
                - evaluator: { params: [{{ alert_5xx_rate_threshold }}], type: gt }
                  operator: { type: and }
                  query: { params: [A] }
                  reducer: { type: last }
                  type: query
              datasource: { type: __expr__, uid: __expr__ }
              expression: A
              refId: C
              type: threshold

      - uid: alert-high-latency
        title: "HighLatency — p95 > {{ alert_latency_p95_threshold }}s"
        condition: C
        for: {{ alert_latency_for }}
        noDataState: OK
        execErrState: Error
        notification_settings:
          receiver: email-admin
        labels:
          severity: warning
          service: bulletins-app
        annotations:
          summary: "HTTP p95 latency above {{ alert_latency_p95_threshold }} second"
          description: "95th percentile request latency is above {{ alert_latency_p95_threshold }}s for {{ alert_latency_for }}."
        data:
          - refId: A
            relativeTimeRange: { from: 600, to: 0 }
            datasourceUid: prometheus
            model:
              editorMode: code
              expr: histogram_quantile(0.95, sum by(le) (rate(http_server_requests_seconds_bucket{application="bulletins"}[5m])))
              instant: true
              range: false
              refId: A
          - refId: C
            datasourceUid: __expr__
            model:
              conditions:
                - evaluator: { params: [{{ alert_latency_p95_threshold }}], type: gt }
                  operator: { type: and }
                  query: { params: [A] }
                  reducer: { type: last }
                  type: query
              datasource: { type: __expr__, uid: __expr__ }
              expression: A
              refId: C
              type: threshold

      - uid: alert-high-cpu
        title: "HighCPU — CPU > {{ alert_cpu_threshold }}% for {{ alert_cpu_for }}"
        condition: C
        for: {{ alert_cpu_for }}
        noDataState: OK
        execErrState: Error
        notification_settings:
          receiver: email-admin
        labels:
          severity: warning
          service: infrastructure
        annotations:
          summary: "High CPU usage on {{ '{{' }} $labels.instance {{ '}}' }}"
          description: "CPU load > {{ alert_cpu_threshold }}% for {{ alert_cpu_for }}."
        data:
          - refId: A
            relativeTimeRange: { from: 600, to: 0 }
            datasourceUid: prometheus
            model:
              editorMode: code
              expr: 100 - (avg by(instance) (rate(node_cpu_seconds_total{mode="idle"}[5m])) * 100)
              instant: true
              range: false
              refId: A
          - refId: C
            datasourceUid: __expr__
            model:
              conditions:
                - evaluator: { params: [{{ alert_cpu_threshold }}], type: gt }
                  operator: { type: and }
                  query: { params: [A] }
                  reducer: { type: last }
                  type: query
              datasource: { type: __expr__, uid: __expr__ }
              expression: A
              refId: C
              type: threshold

      - uid: alert-high-memory
        title: "HighMemory — RAM > {{ alert_memory_threshold }}% for {{ alert_memory_for }}"
        condition: C
        for: {{ alert_memory_for }}
        noDataState: OK
        execErrState: Error
        notification_settings:
          receiver: email-admin
        labels:
          severity: warning
          service: infrastructure
        annotations:
          summary: "High memory usage on {{ '{{' }} $labels.instance {{ '}}' }}"
          description: "Memory usage > {{ alert_memory_threshold }}% for {{ alert_memory_for }}."
        data:
          - refId: A
            relativeTimeRange: { from: 600, to: 0 }
            datasourceUid: prometheus
            model:
              editorMode: code
              expr: 100 * (1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)
              instant: true
              range: false
              refId: A
          - refId: C
            datasourceUid: __expr__
            model:
              conditions:
                - evaluator: { params: [{{ alert_memory_threshold }}], type: gt }
                  operator: { type: and }
                  query: { params: [A] }
                  reducer: { type: last }
                  type: query
              datasource: { type: __expr__, uid: __expr__ }
              expression: A
              refId: C
              type: threshold

      - uid: alert-disk-low
        title: "DiskSpaceLow — root > {{ alert_disk_threshold }}% used"
        condition: C
        for: {{ alert_disk_for }}
        noDataState: OK
        execErrState: Error
        notification_settings:
          receiver: email-admin
        labels:
          severity: warning
          service: infrastructure
        annotations:
          summary: "Low disk space on {{ '{{' }} $labels.instance {{ '}}' }}"
          description: "Root filesystem usage > {{ alert_disk_threshold }}% for {{ alert_disk_for }}."
        data:
          - refId: A
            relativeTimeRange: { from: 900, to: 0 }
            datasourceUid: prometheus
            model:
              editorMode: code
              expr: 100 - (node_filesystem_avail_bytes{mountpoint="/", fstype!~"tmpfs|overlay"} / node_filesystem_size_bytes{mountpoint="/", fstype!~"tmpfs|overlay"}) * 100
              instant: true
              range: false
              refId: A
          - refId: C
            datasourceUid: __expr__
            model:
              conditions:
                - evaluator: { params: [{{ alert_disk_threshold }}], type: gt }
                  operator: { type: and }
                  query: { params: [A] }
                  reducer: { type: last }
                  type: query
              datasource: { type: __expr__, uid: __expr__ }
              expression: A
              refId: C
              type: threshold

      - uid: alert-no-metrics
        title: "NoMetrics — target missing for {{ alert_nometrics_for }}"
        condition: C
        for: {{ alert_nometrics_for }}
        noDataState: Alerting
        execErrState: Error
        notification_settings:
          receiver: email-admin
        labels:
          severity: critical
          service: infrastructure
        annotations:
          summary: "No metrics from {{ '{{' }} $labels.job {{ '}}' }}"
          description: "Prometheus hasn't received metrics from one or more targets for {{ alert_nometrics_for }}."
        data:
          - refId: A
            relativeTimeRange: { from: 600, to: 0 }
            datasourceUid: prometheus
            model:
              editorMode: code
              expr: count(up)
              instant: true
              range: false
              refId: A
          - refId: C
            datasourceUid: __expr__
            model:
              conditions:
                - evaluator: { params: [1], type: lt }
                  operator: { type: and }
                  query: { params: [A] }
                  reducer: { type: last }
                  type: query
              datasource: { type: __expr__, uid: __expr__ }
              expression: A
              refId: C
              type: threshold

      - uid: alert-log-5xx-burst
        title: "Log5xxBurst — 5xx in nginx logs"
        condition: C
        for: {{ alert_log_5xx_for }}
        noDataState: OK
        execErrState: Error
        notification_settings:
          receiver: email-admin
        labels:
          severity: warning
          service: bulletins-app
        annotations:
          summary: "Burst of 5xx errors in nginx logs"
          description: "More than {{ alert_log_5xx_count_threshold }} HTTP 5xx responses in the last 5 minutes (from nginx access logs)."
        data:
          - refId: A
            relativeTimeRange: { from: 600, to: 0 }
            datasourceUid: loki
            model:
              expr: sum(count_over_time({job="nginx-access"} | json | status >= 500 [5m]))
              queryType: range
              refId: A
          - refId: C
            datasourceUid: __expr__
            model:
              conditions:
                - evaluator: { params: [{{ alert_log_5xx_count_threshold }}], type: gt }
                  operator: { type: and }
                  query: { params: [A] }
                  reducer: { type: last }
                  type: query
              datasource: { type: __expr__, uid: __expr__ }
              expression: A
              refId: C
              type: threshold

      - uid: alert-log-app-errors
        title: "LogAppErrors — ERROR logs burst"
        condition: C
        for: {{ alert_log_app_errors_for }}
        noDataState: OK
        execErrState: Error
        notification_settings:
          receiver: email-admin
        labels:
          severity: warning
          service: bulletins-app
        annotations:
          summary: "Burst of ERROR logs in application"
          description: "More than {{ alert_log_app_errors_threshold }} ERROR log lines from bulletins-app in the last 5 minutes."
        data:
          - refId: A
            relativeTimeRange: { from: 600, to: 0 }
            datasourceUid: loki
            model:
              expr: sum(count_over_time({job="docker", container="bulletins-app"} |= "ERROR" [5m]))
              queryType: range
              refId: A
          - refId: C
            datasourceUid: __expr__
            model:
              conditions:
                - evaluator: { params: [{{ alert_log_app_errors_threshold }}], type: gt }
                  operator: { type: and }
                  query: { params: [A] }
                  reducer: { type: last }
                  type: query
              datasource: { type: __expr__, uid: __expr__ }
              expression: A
              refId: C
              type: threshold