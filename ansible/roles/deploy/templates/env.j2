SPRING_PROFILES_ACTIVE=prod
JAVA_OPTS={{ app_java_opts }}

SPRING_DATASOURCE_URL=jdbc:postgresql://{{ pg_host }}:{{ pg_port }}/{{ pg_db }}?sslmode=require
SPRING_DATASOURCE_USERNAME={{ pg_user }}
SPRING_DATASOURCE_PASSWORD={{ pg_password }}

STORAGE_S3_BUCKET={{ s3_bucket }}
STORAGE_S3_REGION={{ s3_region }}
STORAGE_S3_ENDPOINT={{ s3_endpoint }}
STORAGE_S3_ACCESSKEY={{ s3_access_key }}
STORAGE_S3_SECRETKEY={{ s3_secret_key }}
STORAGE_S3_CDNURL=

MANAGEMENT_SERVER_PORT=9090