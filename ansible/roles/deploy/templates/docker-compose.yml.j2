services:
  app:
    image: "{{ app_image }}"
    container_name: "{{ app_name }}-app"
    restart: unless-stopped
    env_file:
      - .env
    ports:
      - "{{ app_port }}:8080"
      - "{{ management_port }}:9090"
    healthcheck:
      test: ["CMD", "wget", "-qO-", "http://127.0.0.1:9090/actuator/health"]
      interval: 30s
      timeout: 5s
      start_period: 60s
      retries: 3
    networks:
      - "{{ app_name }}-net"

networks:
  bulletins-net:
    name: "{{ app_name }}-net"
    driver: bridge